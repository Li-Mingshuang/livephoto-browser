{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LivePhoto 浏览器",
  "version": "0.1.1",
  "identifier": "com.lms.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "LivePhoto 浏览器",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Li Mingshuang",
    "copyright": "MIT License",
    "shortDescription": "Windows 上最好用的 iPhone Live Photo 浏览器",
    "longDescription": "只读浏览 iPhone 导出的 Live Photo：不导入、不复制、不改动任何照片。网格悬停即预览，点一下带声音播放，零转码。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
